{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/data.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "onlinesiparis.cokertmedunyasi.com"
        }
      ],
      "destination": "/uygulama",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/onlinesiparis", "destination": "/uygulama" }
  ]
}
